# Копируется в backend/.env на сервере РЕД ОС 8. Заполнить реальными значениями.

# Строка подключения к PostgreSQL (сервер БД в том же закрытом контуре).
DATABASE_URL=postgresql+psycopg://vacation:CHANGE_ME@db-host:5432/vacation

# "dev" — вход под тестовым пользователем без реального SSO (годится только
# для первичной проверки развёртывания). Боевая схема — "kerberos"
# (см. KERBEROS_* ниже); "oidc" оставлен на случай, если понадобится позже,
# но это не тот протокол, что решено использовать сейчас (и он не
# реализован на бэкенде).
AUTH_PROVIDER=dev

# Kerberos/SPNEGO через AD-домен corp.amurgpz.ru. Логин пользователя —
# локальная часть Kerberos-принципала (до "@REALM"), сопоставляется с
# локальной частью User.email.
#
# KERBEROS_MODE переключает, кто именно проверяет SPNEGO-тикет:
#   "nginx"  — тикет проверяет nginx (модуль с директивами auth_gssapi_*,
#              см. deploy/redos8/nginx-gssapi.conf.example), бэкенду
#              передаётся уже подтверждённый логин в заголовке
#              KERBEROS_TRUSTED_HEADER. Keytab лежит у nginx, не у бэкенда.
#   "python" — тикет проверяет сам бэкенд (пакет python-gssapi, см. ниже),
#              используя KERBEROS_KEYTAB_PATH. nginx — обычный прозрачный
#              прокси, ничего не знающий про Kerberos.
# Какой вариант доступен, зависит от того, есть ли на сервере nginx с
# GSSAPI-модулем (см. nginx-gssapi.conf.example, пункт 1) — если нет,
# используйте "python".
KERBEROS_MODE=nginx
KERBEROS_REALM=CORP.AMURGPZ.RU
# Конкретное имя сервера, на которое заходят пользователи (часть SPN вида
# HTTP/<hostname>@CORP.AMURGPZ.RU) — заполняется, когда IT выдаст keytab
# под конкретный хост. Нужно в обоих режимах (KERBEROS_MODE=nginx — для
# keytab у nginx; KERBEROS_MODE=python — для этой переменной).
KERBEROS_SERVER_HOSTNAME=
# Путь к keytab-файлу НА БЭКЕНДЕ — используется только при
# KERBEROS_MODE=python (при "nginx" keytab кладётся у nginx, эта
# переменная не читается).
KERBEROS_KEYTAB_PATH=
# Заголовок с уже проверенным логином от nginx — используется только при
# KERBEROS_MODE=nginx. Менять вместе с proxy_set_header в конфиге nginx.
KERBEROS_TRUSTED_HEADER=X-Remote-User

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# Источник, с которого браузер открывает фронтенд. При схеме "nginx отдаёт
# фронт и проксирует /api на бэкенд с того же origin" (см. README в этой
# папке) CORS фактически не нужен, но пусть будет корректным на случай
# прямых обращений к :8000.
CORS_ORIGINS=["https://vacation.internal.example"]
